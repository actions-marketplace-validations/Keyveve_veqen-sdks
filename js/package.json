{
  "name": "@veqen/sdk",
  "version": "1.2.0",
  "description": "What every AI request costs, by customer, feature or project, with the key hint that lets Veqen catch stolen keys. Includes the veqen CLI, with an offline coding-agent bill.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./ai-sdk": {
      "types": "./src/index.d.ts",
      "default": "./src/ai-sdk.js"
    },
    "./langchain": {
      "types": "./src/index.d.ts",
      "default": "./src/langchain.js"
    },
    "./prices": {
      "default": "./src/prices.js"
    }
  },
  "bin": {
    "veqen": "./bin/veqen.js"
  },
  "files": [
    "src",
    "bin",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "test": "node --test"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    }
  },
  "keywords": [
    "llm cost",
    "token cost",
    "openai",
    "anthropic",
    "gemini",
    "ai sdk",
    "langchain",
    "budget",
    "finops",
    "pricing"
  ],
  "homepage": "https://veqen-app.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Keyveve/veqen-sdks.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/Keyveve/veqen-sdks/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@langchain/core": ">=0.3"
  }
}
